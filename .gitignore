# Diagnostic output written by the harnesses in scripts/ (screenshots, probe
# dumps, perf traces). Always regenerable by re-running the harness, so it is
# never committed. `npm run clean:artifacts` deletes it.
scripts/*.png
# Generated repro projects (scripts/lib/make*Project.mjs) — rewritten on every
# harness run, never hand-edited. The rig lives in the generator, not here.
scripts/.gi-*/
# GI harness screenshots + probe dumps. Same rule as scripts/*.png: always
# regenerable by re-running the probe, so it never enters history.
.gi-shots/
scripts/*.jpg
scripts/*.jpeg
scripts/*.webp
scripts/*.gif
/artifacts
# HMR quiet-mode sentinel (see vite.config.js) — a local toggle, never shared.
.no-hmr
